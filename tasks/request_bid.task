# lex-economy task spec — LEX_TASK_SPEC=tasks/request_bid.task
#
# Fills the exact gap contract.lex's own task file flagged: "dropped
# Criterion (belongs to request/bid, doesn't exist yet) and the
# budget_ceiling invariant (needs WorkRequest)". This module defines both,
# and reuses contract.lex's existing Money type (imported, not redefined —
# contract.lex is already the shared home for money-shaped types in this
# repo). Criterion here is carried as opaque data only — nothing in this
# module evaluates whether a criterion is met; that is evidence/verdict's
# job once it exists, not yet built.
#
# `capability`/`evidence`/`settlement` (the other remaining modules from the
# original design doc) each have a real, already-shipped lex-soft/lex-spec
# equivalent whose shape differs from the doc's sketch (lex-soft/matchmaking
# for capability matching, lex-soft/verdict for evidence — a much richer
# { intact, linked, legal, verified, spec_applied, score, reason } shape
# than anything reconciled here) — reconciling those is separate groundwork,
# not done as part of this task. request/bid has no such conflict: nothing
# in lex-soft models a request/bid marketplace, so this is a clean, fully
# self-contained module.
#
# REVISED after two failed build attempts (both against kimi-k2.7-code, both
# genuinely doing the right work and both burning a full run before a step-
# limit crash at 10,000,000 interpreter steps -- see project_lex_code memory
# for the separate investigation into whether that ceiling is a legitimate
# limit for a long agentic run). The second crash left src/request_bid.lex
# on disk, and `lex check` on it surfaced the REAL root cause, in this task
# spec, not the model or the interpreter: Lex's ADT constructors live in a
# flat, module-wide namespace, not scoped per type or per module. Importing
# contract.lex (for contract.Money) pulls contract.ContractState's bare
# constructors (Awarded, Cancelled, ...) and contract.Verdict's (Rejected,
# ...) into the SAME namespace this task's own RequestState/BidState
# constructors live in. The original draft reused Awarded/Cancelled/Rejected
# for its own types, which collided and made lex check infer the WRONG type
# for those literals throughout the file. Fixed here by prefixing every
# RequestState/BidState constructor (Req*/Bid*) so nothing this module
# defines can ever collide with an imported module's constructors again --
# this repo's OTHER latent collision (treasury.CommitmentState's `Settled`
# vs contract.ContractState's `Settled`) is not yet a problem because no
# module imports both, but the same prefixing discipline should be applied
# the day one does.

goal = "Create src/request_bid.lex. Import \"./contract\" as contract and reuse contract.Money (do not redefine a local Money type). Define: type Criterion = { attr :: Str, description :: Str } (opaque — nothing in this module evaluates it). type RequestState = ReqOpen | ReqAwarded | ReqCancelled | ReqExpired (prefixed deliberately -- contract.ContractState already defines bare Awarded/Cancelled constructors, and Lex's ADT constructors share ONE flat namespace across every imported module, not one scoped per type, so an unprefixed Awarded/Cancelled here would collide with contract.ContractState's and get mis-typed). type WorkRequest = { id :: Str, buyer :: Str, capability :: Str, description :: Str, budget_ceiling :: contract.Money, criteria :: List[Criterion], deadline_ms :: Int, state :: RequestState }. type BidState = BidSubmitted | BidWithdrawn | BidAccepted | BidRejected (prefixed for the same reason -- contract.Verdict already defines a bare Rejected constructor). type Bid = { id :: Str, request_id :: Str, supplier :: Str, price :: contract.Money, message :: Str, state :: BidState }. Implement: fn post_request(id :: Str, buyer :: Str, capability :: Str, description :: Str, budget_ceiling :: contract.Money, criteria :: List[Criterion], deadline_ms :: Int) -> WorkRequest — pure constructor, state starts ReqOpen. fn submit_bid(request :: WorkRequest, bid_id :: Str, supplier :: Str, price :: contract.Money, message :: Str, now_ms :: Int) -> Result[Bid, Str] — MUST reject (Err, no Bid produced) when: request.state is not ReqOpen (Err(\"request_not_open\")); now_ms > request.deadline_ms (Err(\"deadline_passed\")); price.currency != budget_ceiling.currency (Err(\"currency_mismatch\")); price.cents > budget_ceiling.cents (Err(\"over_budget\") -- THE core invariant this module exists to enforce: no successfully-submitted Bid may ever exceed its WorkRequest's budget_ceiling, checked as an equal-currency integer-cents comparison, never a float). On success returns a Bid in BidSubmitted state referencing request.id. fn withdraw_bid(bid :: Bid) -> Result[Bid, Str] — only valid from BidSubmitted state (Err(\"not_submitted\") otherwise, including double-withdrawal); returns the bid with state BidWithdrawn. fn award(request :: WorkRequest, bids :: List[Bid], winning_bid_id :: Str) -> Result[(WorkRequest, List[Bid]), Str] — MUST fail Err(\"request_not_open\") if request.state is not ReqOpen; Err(\"invalid_bid\") if no bid in `bids` has id == winning_bid_id AND state == BidSubmitted; Err(\"bid_request_mismatch\") if that bid's request_id != request.id. On success: returns the request with state ReqAwarded, and the FULL bids list with the winning bid set to BidAccepted and every OTHER BidSubmitted bid for the same request_id set to BidRejected (bids for a different request_id, or already BidWithdrawn, are left untouched — award only resolves competing live bids on the same request). fn cancel_request(request :: WorkRequest) -> Result[WorkRequest, Str] — valid only from ReqOpen (Err(\"request_not_open\") otherwise, including cancelling an already-ReqAwarded or already-ReqCancelled request); returns the request with state ReqCancelled. fn is_terminal(request :: WorkRequest) -> Bool — true exactly for ReqAwarded, ReqCancelled, ReqExpired; false for ReqOpen. Write examples {} blocks on every pure function (all of the above are pure — no effects, no storage) covering: post_request's initial state; submit_bid's every rejection reason plus one success; withdraw_bid success and double-withdrawal rejection; award's success (winner BidAccepted, a competing bid on the SAME request BidRejected, a bid on a DIFFERENT request_id left BidSubmitted, a BidWithdrawn bid left BidWithdrawn), award on a non-ReqOpen request, award with an unknown/mismatched winning_bid_id; cancel_request success and rejection from a non-ReqOpen state; is_terminal true/false for every state variant."

check       = ["src/request_bid.lex"]
spec_check  = []
test        = []
verified    = ["verified.type_check"]
verified_on = ["src/request_bid.lex:verified.type_check"]
